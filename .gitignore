# Local state and photos are outside the distributable source.
.local/
runtime/
work/
uploads/
imports/
photos/
exports/
cache/
logs/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
*.tmp
*.part
*.zip
*.7z
*.db
*.sqlite*
.env
.env.*

# Model registry is source; model binaries are not.
/models/*
!/models/manifest.json
!/models/relight-manifest.json
!/models/lighting-manifest.json
*.task
*.tflite
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
*.t7

# Do not check in camera originals or local editor state.
*.nef
*.cr2
*.cr3
*.arw
*.raf
*.rw2
*.dng
.vscode/
.idea/

# Session and analysis data must not leak through a custom data root.
previews/
temp/
browser-profile/
browser-cache/
browser-crashes/
state.json
model-receipts.json
*.analysis.npz
*.source.png
*.dmp
